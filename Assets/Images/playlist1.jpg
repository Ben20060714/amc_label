<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400">
  <defs>
    <linearGradient id="playlist1" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7b00ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ff006e;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="400" fill="url(#playlist1)"/>
  <rect x="80" y="80" width="240" height="240" fill="none" stroke="#ffffff" stroke-width="3" opacity="0.2"/>
  <line x1="120" y1="120" x2="280" y2="120" stroke="#ffffff" stroke-width="2" opacity="0.2"/>
  <line x1="120" y1="160" x2="280" y2="160" stroke="#ffffff" stroke-width="2" opacity="0.2"/>
  <line x1="120" y1="200" x2="280" y2="200" stroke="#ffffff" stroke-width="2" opacity="0.2"/>
  <text x="200" y="280" font-size="24" text-anchor="middle" fill="#ffffff" font-weight="bold">Playlist</text>
</svg>
